diff --git a/tests/fate/ffmpeg.mak b/tests/fate/ffmpeg.mak
index ff5dfdd4c84430eeeed238e88ea5013d2bcce5f0..02f39371b015cdd26db055a779bb37f9abd33222 100644
--- a/tests/fate/ffmpeg.mak
+++ b/tests/fate/ffmpeg.mak
@@ -16,6 +16,57 @@ fate-ffmpeg-filter_colorkey: CMD = framecrc -auto_conversion_filters -idct simpl
 FATE_FFMPEG-$(call FILTERFRAMECRC, COLOR) += fate-ffmpeg-lavfi
 fate-ffmpeg-lavfi: CMD = framecrc -lavfi color=d=1:r=5 -fflags +bitexact
 
+# Video starts at 2s, so an automatic seek misses the 0.5s audio window.
+tests/data/seek-stream.mov tests/data/seek-stream-offset.mov: TAG = GEN
+tests/data/seek-stream.mov: ffmpeg$(PROGSSUF)$(EXESUF) | tests/data
+	$(M)$(TARGET_EXEC) $(TARGET_PATH)/$< -nostdin -y -v error \
+        -itsoffset 2 -f lavfi -i "color=s=16x16:r=10:d=1" \
+        -f lavfi -i "sine=sample_rate=8000:d=3" \
+        -map 0:v -map 1:a -c:v mpeg4 -threads:v 1 -g 10 -bf 0 \
+        -flags:v +bitexact -fps_mode passthrough -c:a pcm_s16le \
+        -fflags +bitexact -f mov $(TARGET_PATH)/$@ 2>/dev/null
+
+tests/data/seek-stream-offset.mov: tests/data/seek-stream.mov ffmpeg$(PROGSSUF)$(EXESUF)
+	$(M)$(TARGET_EXEC) $(TARGET_PATH)/ffmpeg$(PROGSSUF)$(EXESUF) -nostdin -y -v error \
+        -i $(TARGET_PATH)/tests/data/seek-stream.mov -map 0 -c copy \
+        -output_ts_offset 5 -fflags +bitexact -f mov $(TARGET_PATH)/$@ 2>/dev/null
+
+FATE_SEEK_STREAM = fate-ffmpeg-seek-stream-specifier fate-ffmpeg-seek-stream-index \
+                   fate-ffmpeg-seek-stream-fractional fate-ffmpeg-seek-stream-offset \
+                   fate-ffmpeg-seek-stream-sseof fate-ffmpeg-seek-stream-default
+FATE_SEEK_STREAM_ERROR = fate-ffmpeg-seek-stream-invalid fate-ffmpeg-seek-stream-unmatched \
+                         fate-ffmpeg-seek-stream-ambiguous
+FATE_FFMPEG-$(call FRAMECRC, MOV, PCM_S16LE, LAVFI_INDEV COLOR_FILTER SINE_FILTER \
+                          WRAPPED_AVFRAME_DECODER MPEG4_ENCODER MOV_MUXER ARESAMPLE_FILTER \
+                          PCM_S16$(if $(filter yes,$(HAVE_BIGENDIAN)),BE,LE)_DECODER) += \
+    $(FATE_SEEK_STREAM) $(FATE_SEEK_STREAM_ERROR)
+$(FATE_SEEK_STREAM) $(FATE_SEEK_STREAM_ERROR): tests/data/seek-stream.mov
+$(FATE_SEEK_STREAM): SRC = $(TARGET_PATH)/tests/data/seek-stream.mov
+$(FATE_SEEK_STREAM): SEEK_OPTIONS = -ss 0.5
+$(FATE_SEEK_STREAM): SEEK_REF = -seek_stream a:0
+$(FATE_SEEK_STREAM): REF = $(SRC_PATH)/tests/ref/fate/ffmpeg-seek-stream-specifier
+$(FATE_SEEK_STREAM): CMD = framecrc $(SEEK_OPTIONS) $(SEEK_REF) -i $(SRC) \
+    -map 0:a:0 -t 0.1 -c:a pcm_s16le
+fate-ffmpeg-seek-stream-index: SEEK_REF = -seek_stream 1
+fate-ffmpeg-seek-stream-fractional: SEEK_OPTIONS = -ss 0.5001
+fate-ffmpeg-seek-stream-fractional: REF = $(SRC_PATH)/tests/ref/fate/ffmpeg-seek-stream-fractional
+fate-ffmpeg-seek-stream-offset: tests/data/seek-stream-offset.mov
+fate-ffmpeg-seek-stream-offset: SRC = $(TARGET_PATH)/tests/data/seek-stream-offset.mov
+fate-ffmpeg-seek-stream-sseof: SEEK_OPTIONS = -sseof -2.5
+fate-ffmpeg-seek-stream-default: SEEK_REF =
+fate-ffmpeg-seek-stream-default: REF = $(SRC_PATH)/tests/ref/fate/ffmpeg-seek-stream-default
+$(FATE_SEEK_STREAM_ERROR): CMD = ! run $(FFMPEG) -nostdin -hide_banner -v error \
+    -ss 0.5 -seek_stream $(SEEK_STREAM) -i $(TARGET_PATH)/tests/data/seek-stream.mov \
+    -map 0:a:0 -t 0.1 -c:a pcm_s16le -f framecrc -
+$(FATE_SEEK_STREAM_ERROR): CMP = grep
+fate-ffmpeg-seek-stream-invalid: SEEK_STREAM = a:bogus
+fate-ffmpeg-seek-stream-invalid: REF = Trailing garbage at the end of a stream specifier
+fate-ffmpeg-seek-stream-unmatched: SEEK_STREAM = a:9
+fate-ffmpeg-seek-stream-unmatched: REF = matches no streams
+# An empty stream specifier matches every stream in the input.
+fate-ffmpeg-seek-stream-ambiguous: SEEK_STREAM = ""
+fate-ffmpeg-seek-stream-ambiguous: REF = matches multiple streams
+
 FATE_FFMPEG-$(call FILTERFRAMECRC, TESTSRC2 FORMAT SETPARAMS SCALE, LAVFI_INDEV WRAPPED_AVFRAME_DECODER MPEG2VIDEO_ENCODER) += fate-ffmpeg-chroma-location
 fate-ffmpeg-chroma-location: CMD = framecrc -auto_conversion_filters -f lavfi -i testsrc2=s=64x64:r=25:d=1,format=yuv420p,setparams=chroma_location=topleft -sws_flags +accurate_rnd+bitexact -flags +bitexact -idct simple -dct fastint -threads 1 -c:v mpeg2video -qscale:v 2 -frames:v 1
 
